<Window x:Class="MultiRoomTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiRoomTimer"
        xmlns:viewmodels="clr-namespace:MultiRoomTimer.ViewModels"
        xmlns:converters="clr-namespace:MultiRoomTimer.Converters"
        mc:Ignorable="d"
        Title="マルチルームタイマー管理システム" Height="850" Width="1400">
    <Window.Resources>
        <converters:RadioButtonValueConverter x:Key="RadioButtonValueConverter"/>

        <Style TargetType="RadioButton" x:Key="TabRadioButtonStyle">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="45"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="border" BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="DodgerBlue"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGray"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ItemsControl ItemsSource="{Binding Rooms}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" Rows="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Background="{Binding StatusBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Room Number and Timer Display -->
                            <TextBlock Grid.Row="0" Text="{Binding RoomNumber, StringFormat='Room {0}'}" FontWeight="Bold" FontSize="16" Margin="5" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,5,0,10">
                                <TextBlock Text="{Binding DisplayTimeString}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EstimatedEndTimeString}" FontSize="12" Foreground="DarkSlateGray" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Inputs -->
                            <Grid Grid.Row="2" Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <TextBlock Text="Cast: " VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CastName, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" IsEnabled="{Binding IsAvailable}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Course (min):" Margin="5,5,5,0"/>
                                    <WrapPanel Margin="5,0" IsEnabled="{Binding IsAvailable}">
                                        <RadioButton Content="45" IsChecked="{Binding SelectedCourse, Converter={StaticResource RadioButtonValueConverter}, ConverterParameter=45, Mode=TwoWay}" GroupName="{Binding RoomNumber, StringFormat='Course{0}'}" Style="{StaticResource TabRadioButtonStyle}"/>
                                        <RadioButton Content="60" IsChecked="{Binding SelectedCourse, Converter={StaticResource RadioButtonValueConverter}, ConverterParameter=60, Mode=TwoWay}" GroupName="{Binding RoomNumber, StringFormat='Course{0}'}" Style="{StaticResource TabRadioButtonStyle}"/>
                                        <RadioButton Content="70" IsChecked="{Binding SelectedCourse, Converter={StaticResource RadioButtonValueConverter}, ConverterParameter=70, Mode=TwoWay}" GroupName="{Binding RoomNumber, StringFormat='Course{0}'}" Style="{StaticResource TabRadioButtonStyle}"/>
                                        <RadioButton Content="90" IsChecked="{Binding SelectedCourse, Converter={StaticResource RadioButtonValueConverter}, ConverterParameter=90, Mode=TwoWay}" GroupName="{Binding RoomNumber, StringFormat='Course{0}'}" Style="{StaticResource TabRadioButtonStyle}"/>
                                        <RadioButton Content="120" IsChecked="{Binding SelectedCourse, Converter={StaticResource RadioButtonValueConverter}, ConverterParameter=120, Mode=TwoWay}" GroupName="{Binding RoomNumber, StringFormat='Course{0}'}" Style="{StaticResource TabRadioButtonStyle}"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Type:" Margin="5,5,5,0"/>
                                    <WrapPanel Margin="5,0" IsEnabled="{Binding IsAvailable}">
                                        <RadioButton Content="F" IsChecked="{Binding SelectedType, Converter={StaticResource RadioButtonValueConverter}, ConverterParameter=F, Mode=TwoWay}" GroupName="{Binding RoomNumber, StringFormat='Type{0}'}" Style="{StaticResource TabRadioButtonStyle}"/>
                                        <RadioButton Content="H" IsChecked="{Binding SelectedType, Converter={StaticResource RadioButtonValueConverter}, ConverterParameter=H, Mode=TwoWay}" GroupName="{Binding RoomNumber, StringFormat='Type{0}'}" Style="{StaticResource TabRadioButtonStyle}"/>
                                        <RadioButton Content="N" IsChecked="{Binding SelectedType, Converter={StaticResource RadioButtonValueConverter}, ConverterParameter=N, Mode=TwoWay}" GroupName="{Binding RoomNumber, StringFormat='Type{0}'}" Style="{StaticResource TabRadioButtonStyle}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Buttons -->
                            <WrapPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="5">
                                <Button Content="Start" Command="{Binding StartCommand}" Margin="2" Padding="8,3"/>
                                <Button Content="{Binding PauseButtonContent}" Command="{Binding TogglePauseCommand}" Margin="2" Padding="8,3"/>
                                <Button Content="+30" Command="{Binding AddTimeCommand}" Margin="2" Padding="8,3"/>
                                <Button Content="End" Command="{Binding EndCommand}" Margin="2" Padding="8,3" Background="IndianRed" Foreground="White"/>
                                <Button Content="Reset" Command="{Binding ResetCommand}" Margin="2" Padding="8,3"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
            <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Gray"/>
            <Button Content="Generate Yearly Report" Command="{Binding GenerateReportCommand}" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>