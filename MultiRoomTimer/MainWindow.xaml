<Window x:Class="MultiRoomTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiRoomTimer"
        xmlns:viewmodels="clr-namespace:MultiRoomTimer.ViewModels"
        mc:Ignorable="d"
        Title="Multi-Room Timer Management" Height="800" Width="1200">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <ItemsControl ItemsSource="{Binding Rooms}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" Rows="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Background="{Binding StatusBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding RoomNumber, StringFormat='Room {0}'}" FontWeight="Bold" FontSize="16" Margin="5" HorizontalAlignment="Center"/>

                            <StackPanel Grid.Row="1" Margin="5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RemainingTimeString}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="Cast: "/>
                                    <TextBox Text="{Binding CastName, UpdateSourceTrigger=PropertyChanged}" MinWidth="100"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="Course: "/>
                                    <TextBox Text="{Binding CourseType, UpdateSourceTrigger=PropertyChanged}" MinWidth="100"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                                <Button Content="Start 60min" Command="{Binding StartCommand}" CommandParameter="60" Margin="2"/>
                                <Button Content="Start 90min" Command="{Binding StartCommand}" CommandParameter="90" Margin="2"/>
                                <Button Content="Stop" Command="{Binding StopCommand}" Margin="2"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="1" Content="Export to Excel" Command="{Binding ExportCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"/>
    </Grid>
</Window>